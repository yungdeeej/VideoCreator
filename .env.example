# ----- StoryForge backend environment -----
# Copy this file to ".env" (in the repo root) and fill in real values.
# On Replit, set these as Secrets instead of committing a .env file.

# fal.ai API key. REQUIRED for real generation.
# This is a backend-only secret and must NEVER be exposed to the browser.
FAL_KEY=

# Anthropic API key — powers the optional Claude prompt assistant (turns rough
# ideas / loglines into polished image + motion prompts). Backend-only secret.
# Leave blank to disable the assistant, or set CLAUDE_MOCK=1 to try it with
# templated suggestions (no API calls).
ANTHROPIC_API_KEY=

# Claude model for the prompt assistant. Default: claude-opus-4-8.
ANTHROPIC_MODEL=claude-opus-4-8

# Mock mode for the prompt assistant: "1" returns templated suggestions
# without calling Claude (lets you exercise the UI without a key).
CLAUDE_MOCK=0

# Port the backend HTTP server listens on. Default 8787.
PORT=8787

# Where generated assets + the JSON project store live (relative to server/ or absolute).
# Default: server/data
DATA_DIR=

# Path to the ffmpeg binary. Defaults to "ffmpeg" (must be on PATH).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Path to a TrueType font used for title cards + text overlays (drawtext).
# Defaults to a bundled-safe DejaVu Sans path; override for a pixel-friendly font.
FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Max number of fal jobs allowed in-flight at once (rate-limit guard). Default 8.
MAX_CONCURRENT_JOBS=8

# Mock mode: when set to "1", no fal calls are made. Instead the backend
# synthesizes placeholder stills/clips locally with ffmpeg so the full
# storyboard -> generate -> combine -> export pipeline can be exercised
# without a FAL_KEY. Leave empty/0 for real generation.
FAL_MOCK=0

# Public base URL of this backend (used so fal can fetch locally-uploaded
# reference images when NOT using fal storage). Usually leave blank — the
# backend uploads refs to fal storage by default.
PUBLIC_BASE_URL=
